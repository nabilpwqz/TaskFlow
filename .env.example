# ==============================================================================
# TaskFlow Marketplace — Environment Variable Template
# IMPORTANT: Copy this file to '.env.local' and provide genuine values for deployment.
# NEVER commit your genuine production keys or credentials to version control.
# ==============================================================================

# Database: MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/taskflow?retryWrites=true&w=majority

# JWT Session Secret: Minimum 32 characters high-entropy cryptographic secret
JWT_SECRET=your_jwt_secret_must_be_at_least_32_characters_long_min

# Application Base Configuration
APP_COOKIE_NAME=taskflow_session
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase Client Configuration (Optional for Google OAuth)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Optional Integration Testing Secrets (For local test runs only)
# TEST_AUTH_PASSWORD=
